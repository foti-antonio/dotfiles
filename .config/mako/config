# mako — notifiche (i popup inviati dalle app)
#
#   Documentazione   `man 5 mako`
#   Ricarica         `makoctl reload`
#   Prova            `notify-send "titolo" "testo"`
#
# I commenti devono stare su una riga a sé.

# Angolo dello schermo in cui compaiono.
anchor=top-right

# Font: "famiglia dimensione", dimensione in punti.
font=JetBrainsMono Nerd Font 10

# Colori in formato #RRGGBB (gruvbox dark, come nelle altre configurazioni).
background-color=#1d2021
text-color=#ebdbb2
border-color=#a89984

# Spessore del bordo, in pixel.
border-size=2

# Angoli arrotondati, in pixel.
border-radius=4

# Durata in millisecondi (0 = non scompare da sola). Vale se l'app non ne
# chiede una propria.
default-timeout=5000

# Massimo di notifiche visibili insieme; le più vecchie aspettano nascoste.
max-visible=3
