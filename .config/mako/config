# mako — demone delle notifiche (i popup inviati dalle app).
# Documentazione: `man 5 mako`
# I commenti devono stare su una riga a sé. Applicare le modifiche con
# `makoctl reload`, provare con `notify-send "titolo" "testo"`.

# Angolo dello schermo in cui compaiono le notifiche.
anchor=top-right
# Font come "famiglia dimensione" (dimensione in punti).
font=JetBrainsMono Nerd Font 10
# I colori sono #RRGGBB (gruvbox dark, come nelle altre configurazioni).
background-color=#1d2021
text-color=#ebdbb2
border-color=#a89984
# Spessore del bordo, in pixel.
border-size=2
# Arrotondamento degli angoli, in pixel.
border-radius=4
# Millisecondi prima che una notifica scompaia da sola (0 = mai), a meno che
# l'app non chieda una durata propria.
default-timeout=5000
# Al massimo questo numero di notifiche sullo schermo contemporaneamente; le
# più vecchie restano nascoste finché non c'è spazio.
max-visible=3
