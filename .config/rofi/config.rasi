@theme "/dev/null"

configuration {
  font: "JetBrainsMono Nerd Font 11";
  show-icons: false;
  display-drun: "run";
  drun-display-format: "{name}";
}

* {
  bg:     #1d2021;
  bg-alt: #3c3836;
  fg:     #ebdbb2;
  dim:    #7c6f64;
  accent: #a89984;

  background-color: transparent;
  text-color: @fg;
}

window {
  width: 480px;
  background-color: @bg;
  border: 2px;
  border-color: @accent;
  border-radius: 4px;
}

mainbox  { padding: 8px; spacing: 8px; children: [ inputbar, listview ]; }
inputbar { padding: 6px; background-color: @bg-alt; border-radius: 4px; children: [ prompt, entry ]; spacing: 8px; }
prompt   { text-color: @accent; }
entry    { placeholder: ""; }
listview { lines: 8; scrollbar: false; fixed-height: false; }
element  { padding: 4px 6px; border-radius: 4px; }
element-text { text-color: inherit; }
element normal.normal,
element alternate.normal { background-color: @bg; text-color: @fg; }
element normal.active,
element alternate.active { background-color: @bg; text-color: @accent; }
element normal.urgent,
element alternate.urgent { background-color: @bg; text-color: #cc241d; }
element selected.normal,
element selected.active,
element selected.urgent  { background-color: @accent; text-color: @bg; }
