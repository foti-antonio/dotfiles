// waybar — barra di stato: COSA mostra (l'aspetto è in style.css)
//
//   Documentazione   `man 5 waybar`; una pagina per modulo, es.
//                    `man 5 waybar-battery`
//   Ricarica         `pkill waybar; waybar &`
//
// Icone: sono glifi del Nerd Font impostato in style.css. Il nome di ognuna
// è nel commento sopra (si cerca su nerdfonts.com/cheat-sheet). Dopo ogni
// icona ci sono due spazi, perché i glifi sono più larghi di una lettera.
{
  // Livello: "top" = sopra le finestre normali, "bottom" = sotto. Le finestre
  // a schermo intero la coprono comunque.
  "layer": "top",

  // Lato dello schermo: top, bottom, left, right.
  "position": "top",

  // Altezza, in pixel.
  "height": 24,

  // Spazio tra i moduli, in pixel.
  "spacing": 8,

  // Moduli a sinistra, al centro e a destra, in ordine. Ognuno è configurato
  // nel proprio blocco più sotto.
  "modules-left": ["ext/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["network", "bluetooth", "backlight", "pulseaudio", "cpu", "memory", "battery", "tray"],

  // Tag 1-9, letti da mango con il protocollo ext-workspace.
  "ext/workspaces": {
    // Testo del pulsante: {name} = nome del tag (il suo numero).
    "format": "{name}",

    // Clic su un pulsante: passa a quel tag.
    "on-click": "activate",

    // Pulsanti in ordine di numero.
    "sort-by-id": true,

    // false = mostra anche i tag vuoti (mango li segna "hidden"): tutti e nove
    // restano sulla barra, attenuati da style.css.
    "ignore-hidden": false
  },

  // Orologio.
  "clock": {
    // Formato strftime → "Thu 19 Nov  22:17"
    //   %a giorno della settimana, %d giorno, %b mese, %H:%M ora (24h)
    "format": "{:%a %d %b  %H:%M}",

    // Nessun popup al passaggio del mouse.
    "tooltip": false
  },

  // Wi-Fi.
  //   clic sinistro   apre nmtui per scegliere una rete
  //   clic destro     spegne / accende il Wi-Fi
  "network": {
    // Solo interfacce wireless (wlan0). Senza, il modulo potrebbe mostrare
    // t2_ncm, il collegamento interno del MacBook con il chip T2.
    "interface": "wl*",

    // Connesso. Icona: nf-md-wifi
    //   {essid} = nome della rete, {signalStrength} = segnale in percentuale
    "format-wifi": "󰖩  {essid} {signalStrength}%",

    // Wi-Fi acceso ma non connesso.
    "format-disconnected": "󰖩  --",

    // Wi-Fi spento (rfkill). Icona: nf-md-wifi_off
    "format-disabled": "󰖪",

    // Lunghezza massima del testo, in caratteri (per i nomi di rete lunghi).
    "max-length": 28,

    // Aggiornamento ogni 10 secondi (per il segnale).
    "interval": 10,

    // Al passaggio del mouse: interfaccia, indirizzo IP/prefisso, banda.
    "tooltip-format-wifi": "{ifname}  {ipaddr}/{cidr}  {frequency} GHz",

    // Clic sinistro: nmtui dentro foot (-e). --app-id dà un nome alla
    // finestra, così mango la rende flottante (regole in mango/config.conf).
    "on-click": "foot --app-id=nmtui -e nmtui",

    // Clic destro: `nmcli radio wifi` stampa "enabled" o "disabled"; si passa
    // all'altro stato.
    "on-click-right": "[ \"$(nmcli radio wifi)\" = enabled ] && nmcli radio wifi off || nmcli radio wifi on"
  },

  // Bluetooth.
  //   clic sinistro   apre bluetui per associare e connettere i dispositivi
  //   clic destro     spegne / accende l'adattatore
  "bluetooth": {
    // Acceso, nessun dispositivo connesso. Icona: nf-md-bluetooth
    "format": "󰂯",

    // Connesso. Icona: nf-md-bluetooth_connect
    //   {device_alias} = nome del dispositivo
    "format-connected": "󰂱  {device_alias}",

    // Come sopra, per i dispositivi che comunicano la carica della batteria.
    "format-connected-battery": "󰂱  {device_alias} {device_battery_percentage}%",

    // Spento o bloccato da rfkill. Icona: nf-md-bluetooth_off
    "format-off": "󰂲",
    "format-disabled": "󰂲",

    // Nessun adattatore: testo vuoto = modulo nascosto.
    "format-no-controller": "",

    // Lunghezza massima del testo, in caratteri.
    "max-length": 24,

    // Al passaggio del mouse: i dispositivi connessi, uno per riga.
    "tooltip-format-connected": "{device_enumerate}",

    // Clic sinistro: bluetui dentro foot.
    "on-click": "foot --app-id=bluetui -e bluetui",

    // Clic destro: se `bluetoothctl show` contiene "Powered: yes" l'adattatore
    // è acceso e viene spento, altrimenti viene acceso.
    "on-click-right": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on"
  },

  // Luminosità dello schermo. La rotellina sul modulo la cambia.
  "backlight": {
    // Dispositivo da mostrare e regolare. Indicato per nome perché questo
    // MacBook ne ha due (l'altro è la Touch Bar). Elenco: `brightnessctl -l`
    "device": "gmux_backlight",

    // Icona: nf-md-brightness_6
    //   {percent} = luminosità in percentuale
    "format": "󰃟  {percent}%",

    // Uno scatto di rotellina = 5 punti percentuali, come i tasti della
    // luminosità.
    "scroll-step": 5,

    // Minimo 5%: così lo schermo non si spegne per sbaglio.
    "min-brightness": 5,

    // Nessun popup al passaggio del mouse.
    "tooltip": false
  },

  // Volume (PipeWire, tramite l'interfaccia PulseAudio). La rotellina sul
  // modulo lo cambia.
  "pulseaudio": {
    // Icona: nf-md-volume_high
    //   {volume} = volume di uscita in percentuale
    "format": "󰕾  {volume}%",

    // Uscita silenziata. Icona: nf-md-volume_off
    "format-muted": "󰖁",

    // Clic: muto sì/no.
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  // CPU.
  "cpu": {
    // Icona: nf-oct-cpu
    //   {usage} = carico totale della CPU in percentuale
    "format": "  {usage}%",

    // Aggiornamento ogni 5 secondi.
    "interval": 5
  },

  // Memoria.
  "memory": {
    // Icona: nf-fa-memory
    //   {percentage} = quota di RAM in uso
    "format": "  {percentage}%",

    // Aggiornamento ogni 10 secondi.
    "interval": 10
  },

  // Batteria.
  "battery": {
    // {icon} = una delle format-icons qui sotto
    // {capacity} = carica in percentuale
    "format": "{icon}  {capacity}%",

    // Un'icona per livello di carica, da scarica a piena, distribuite su
    // 0-100%: nf-md-battery_10 ... nf-md-battery_90, nf-md-battery
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],

    // format-<stato> sostituisce "format" in quello stato.
    // Icona nf-md-battery_charging: in carica, oppure collegata alla corrente
    // a batteria piena.
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "󰂄  {capacity}%",

    // Soglie: al 20% o meno il modulo riceve la classe CSS "warning", al 10% o
    // meno "critical" (colorate in style.css).
    "states": { "warning": 20, "critical": 10 },

    // Aggiornamento ogni 30 secondi.
    "interval": 30,

    // Al passaggio del mouse: tempo stimato alla scarica o alla carica
    // completa.
    "tooltip-format": "{timeTo}"
  },

  // Area di notifica: icone delle app in background (rete, chat, ...).
  "tray": {
    // Spazio tra le icone, in pixel.
    "spacing": 6
  }
}
